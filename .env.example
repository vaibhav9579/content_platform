# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/content_platform?schema=public"
# Optional pooled connection string (e.g. PgBouncer / Neon / Supabase pooler)
DIRECT_URL="postgresql://user:password@localhost:5432/content_platform?schema=public"

# ---------------------------------------------------------------------------
# Clerk Authentication — https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxx"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ---------------------------------------------------------------------------
# Cloudinary — https://cloudinary.com/console
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="xxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxx"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="content_platform_unsigned"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="The Publication"

# Comma-separated Clerk user emails that should be bootstrapped as ADMIN
# the first time they sign in. Use this only for the first owner account —
# every other teammate's role (Editor/Author/Contributor) is granted from
# the in-app Team page (Admin > Team) instead.
ADMIN_EMAILS="you@example.com"

# ---------------------------------------------------------------------------
# Search engine verification
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# Revalidation & Cron
# ---------------------------------------------------------------------------
REVALIDATE_SECRET="a-long-random-string"
# Set this on Vercel and it auto-authenticates the scheduled-publish cron
# (see vercel.json) — no manual header wiring needed.
CRON_SECRET="another-long-random-string"

# ---------------------------------------------------------------------------
# Rate limiting — https://console.upstash.com (free tier is plenty)
# ---------------------------------------------------------------------------
# Optional. Without these, rate limiting falls back to an in-memory limiter
# that only works correctly on a single long-lived instance (fine for local
# dev; NOT safe across multiple serverless instances in production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Email — https://resend.com (free tier: 100/day, 3,000/month)
# ---------------------------------------------------------------------------
# Optional. Without RESEND_API_KEY, newsletter emails are silently skipped
# (subscriptions still work — this only gates the "new post" notification).
RESEND_API_KEY=""
# Must be on a domain you've verified in Resend. The sandbox default below
# only delivers to your own Resend account email — fine for testing.
EMAIL_FROM="onboarding@resend.dev"

# ---------------------------------------------------------------------------
# IndexNow — instant Bing/Yandex indexing on publish, no account needed
# ---------------------------------------------------------------------------
# Any random string you generate yourself (e.g. `openssl rand -hex 16`).
# Optional — without it, IndexNow submission is silently skipped.
INDEXNOW_KEY=""
